{
  "name": "standup-scribe",
  "version": "1.0.0",
  "description": "Turn your git commits across every local repo into daily standups, weekly reviews, and timesheets — with automatic time estimates",
  "license": "MIT",
  "author": "Neel Bhavsar (https://github.com/neeelbhavsar)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neeelbhavsar/standup-scribe.git"
  },
  "bugs": {
    "url": "https://github.com/neeelbhavsar/standup-scribe/issues"
  },
  "homepage": "https://github.com/neeelbhavsar/standup-scribe#readme",
  "type": "module",
  "bin": {
    "standup-scribe": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run build && npm run lint && npm run test"
  },
  "keywords": [
    "standup",
    "standup-scribe",
    "git",
    "git-log",
    "commits",
    "cli",
    "daily-standup",
    "team-standup",
    "weekly-report",
    "timesheet",
    "time-tracking",
    "productivity",
    "developer-tools"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "conf": "^12.0.0",
    "dayjs": "^1.11.10",
    "ora": "^8.0.1",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/ui": "^1.2.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "tsup": "^8.0.2",
    "vitest": "^1.2.0"
  }
}
